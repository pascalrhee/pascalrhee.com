---
import InteractiveHoverButton from '../../components/21st/InteractiveHoverButton.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCards from '../../components/WorkCards.astro';
---

<BaseLayout
  title="Work · Pascal Rhee"
  description="Public projects and experiments by Pascal Rhee, built with Astro and Cloudflare Workers."
  section="projects"
>
  <header class="page-head">
    <p class="eyebrow">Selected public work</p>
    <h1 class="display">
      Made to learn.
      <br />
      <em>Built to work.</em>
    </h1>
    <p class="lede">
      A mix of live projects, personal experiments, and ideas I’m still
      exploring. Each is a way to understand the tools and tradeoffs a little
      better.
    </p>
  </header>
  <section class="page-section">
    <h2 class="sr-only">Public projects</h2>
    <WorkCards />
  </section>
  <section class="page-section detail-grid" aria-label="Project details">
    <article class="detail" id="personal-site">
      <p class="section-label">01 / Personal website</p>
      <h2 class="detail-title">One small home base.</h2>
      <p>
        This site brings my background and projects into a single, deliberately
        lightweight place. Astro generates static HTML; Cloudflare Workers
        serves the assets from the edge.
      </p>
      <p>
        Shared layouts keep the pages consistent. Responsive CSS, semantic
        markup, and a mostly static interface keep the experience simple across
        devices.
      </p>
      <div class="pill-row">
        <span>Astro</span>
        <span>HTML & CSS</span>
        <span>Cloudflare Workers</span>
      </div>
      <p>
        <a href="https://github.com/pascalrhee/pascalrhee.com">
          Explore the source <span class="arrow" aria-hidden="true"></span>
        </a>
      </p>
    </article>
    <article class="detail" id="edge-counter">
      <p class="section-label">02 / Edge computing experiment</p>
      <h2 class="detail-title">A rolling view counter.</h2>
      <p>
        An earlier API counted page loads in hourly buckets, with a time to live
        of 30 hours. A read endpoint added the latest 24 buckets into a rolling
        total.
      </p>
      <p>
        This retired experiment explored keeping a small dynamic feature beside
        a static site. The public API is now disabled, and the site no longer
        collects visitor counts. The illustration above is a schematic, not live
        traffic data.
      </p>
      <div class="pill-row">
        <span>TypeScript</span>
        <span>Workers KV</span>
        <span>REST API</span>
      </div>
      <p>
        <a href="https://github.com/pascalrhee/pascalrhee.com/blob/d123cf899263d020da55b1874cd19865960fe8dd/src/worker/index.ts">
          Read the original implementation{' '}
          <span class="arrow" aria-hidden="true"></span>
        </a>
      </p>
    </article>
  </section>
  <section class="page-section" aria-labelledby="in-progress-title">
    <div class="section-head">
      <div>
        <p class="section-label">03 / On my desk</p>
        <h2 class="section-title" id="in-progress-title">
          Building to <em>learn.</em>
        </h2>
      </div>
      <p>Personal experiments and early ideas. These are works in progress.</p>
    </div>
    <div class="detail-grid">
      <article class="detail" id="personal-assistant">
        <p class="section-label">Experiment</p>
        <h3>A personal AI assistant</h3>
        <p>
          An ongoing personal project exploring AI assistants and automation. A
          practical way to learn how tools fit together and where automation
          needs human judgment.
        </p>
        <div class="pill-row">
          <span>AI assistants</span>
          <span>Automation</span>
          <span>Human judgment</span>
        </div>
      </article>
      <article class="detail" id="simulation-games">
        <p class="section-label">Exploring</p>
        <h3>Simulation games grounded in real data</h3>
        <p>
          I’m exploring simulation game ideas grounded in published data. I’m
          interested in how a small set of player decisions can reveal the
          tradeoffs inside a complex system.
        </p>
        <div class="pill-row">
          <span>Game ideas</span>
          <span>Published data</span>
          <span>Systems thinking</span>
        </div>
      </article>
    </div>
  </section>
  <section class="contact-panel">
    <div>
      <h2>The professional side of the story.</h2>
      <p>My background spans applied AI, commercial operations, and product.</p>
    </div>
    <InteractiveHoverButton href="/about/" label="About my work" />
  </section>
</BaseLayout>
