---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <section class="content">
    <h1>Pascal Rhee<br /><span class="italic">is building.</span></h1>

    <p class="lede">
      A personal site is going up here — a record of projects, a build log
      of what's being learned, and the occasional thing worth reading.
      <em>Coming together in public.</em>
    </p>

    <div class="meta">
      <span><span class="label">STATUS</span>domain claimed · site under construction</span>
      <span><span class="label">STACK</span>astro · cloudflare pages · claude code</span>
      <span><span class="label">NEXT</span>first real commit</span>
    </div>
  </section>
</BaseLayout>
