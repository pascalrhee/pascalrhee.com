---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageViewCounter from '../components/PageViewCounter.astro';
---
<BaseLayout>
  <section class="content">
    <h1>Pascal Rhee<br /><span class="italic">is building.</span></h1>

    <p class="lede">
      A personal site is going up here — a record of projects, a build log
      of what's being learned, and the occasional thing worth reading.
      <em>Coming together in public.</em>
    </p>

    <PageViewCounter />

    <div class="meta">
      <span><span class="label">STATUS</span>domain claimed · under construction</span>
      <span><span class="label">STACK</span>astro · cloudflare workers · claude code</span>
      <span><span class="label">NEXT</span>real content</span>
    </div>
  </section>
</BaseLayout>
