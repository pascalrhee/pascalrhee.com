---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackgroundPaths from '../components/21st/BackgroundPaths.astro';
import InteractiveHoverButton from '../components/21st/InteractiveHoverButton.astro';
import WorkCards from '../components/WorkCards.astro';
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <div class="eyebrow">
        <span class="status-dot"></span> Applied AI · Product · People
      </div>
      <h1>
        Making AI work
        <br />
        for <em>people.</em>
      </h1>
      <p>
        I’m <strong>Pascal</strong>, a data scientist working where technology
        meets the people who use it. I turn business problems into practical,
        working solutions.
      </p>
      <div class="hero-actions">
        <InteractiveHoverButton href="/projects/" label="Explore my work" />
        <a class="text-link" href="/about/">
          A little about me
        </a>
      </div>
      <div class="hero-foot">
        <span>DATA SCIENTIST @ ABS</span>
        <span>MICHIGAN ALUM</span>
      </div>
    </div>
    <BackgroundPaths />
  </section>
  <div class="intro-band">
    <div>
      <small>Currently</small>
      <p>Building practical AI at ABS</p>
    </div>
    <div>
      <small>Previously</small>
      <p>Applied AI / Commercial / Product</p>
    </div>
    <div>
      <small>Foundation</small>
      <p>University of Michigan · Data Science</p>
    </div>
  </div>
  <section class="section" aria-labelledby="work-title">
    <div class="section-head">
      <div>
        <p class="section-label">01 / Out in the open</p>
        <h2 id="work-title">
          Small builds. <em>Real curiosity.</em>
        </h2>
      </div>
      <p>
        A few things I can share publicly.
        <br />
        Built to learn, and made to be used.
      </p>
    </div>
    <WorkCards />
  </section>
  <section class="section approach" aria-labelledby="approach-title">
    <div class="approach-title">
      <p class="section-label">02 / How I work</p>
      <h2 id="approach-title">
        The useful part is
        <br />
        bringing it <em>together.</em>
      </h2>
      <p>
        My work spans applied AI, commercial operations, and product. I like
        understanding a workflow, making the tradeoffs clear, and building
        something concrete to learn from.
      </p>
      <a class="text-link" href="/about/">
        More on my background <span class="arrow" aria-hidden="true"></span>
      </a>
    </div>
    <ol class="steps">
      <li>
        <span class="step-number">01</span>
        <div>
          <h3>Start with the actual problem.</h3>
          <p>
            Understand the workflow, ask better questions, and make the
            constraints explicit before choosing the technology.
          </p>
        </div>
      </li>
      <li>
        <span class="step-number">02</span>
        <div>
          <h3>Make something people can react to.</h3>
          <p>
            Turn requirements into working prototypes. Use a concrete
            demonstration to test assumptions and find the gaps.
          </p>
        </div>
      </li>
      <li>
        <span class="step-number">03</span>
        <div>
          <h3>Connect the technical and the human.</h3>
          <p>
            Translate between business and engineering, with attention to
            usability, tradeoffs, and the path to adoption.
          </p>
        </div>
      </li>
    </ol>
  </section>
  <section class="section two-col" aria-labelledby="off-screen-title">
    <div>
      <p class="section-label">03 / Off screen</p>
      <h2 id="off-screen-title">
        Still <em>curious.</em>
      </h2>
    </div>
    <div class="body-copy">
      <p>
        Outside work, I’m usually exploring an AI project, playing pickleball,
        or adding to my Pokémon card collection.
      </p>
      <a class="text-link" href="/about/#beyond-work">
        A few of my interests <span class="arrow" aria-hidden="true"></span>
      </a>
    </div>
  </section>
  <section class="contact-panel">
    <div>
      <h2>Good work starts with a conversation.</h2>
      <p>Applied AI, useful products, and interesting problems. Let’s talk.</p>
    </div>
    <InteractiveHoverButton
      href="https://www.linkedin.com/in/jprhee/"
      label="Connect on LinkedIn"
    />
  </section>
</BaseLayout>
