---
// Original implementation. Interaction inspiration: 21st.dev's Aether Ribbon Mesh.
const loops = Array.from({ length: 32 }, (_, i) => i);
---
<figure class="kinetic" aria-label="An interactive wire sculpture. Move your pointer to turn it, or scroll to shift its perspective.">
  <div class="kinetic-caption"><span>FIELD NOTES / 001</span><span>FORM & FUNCTION</span></div>
  <div class="kinetic-stage">
    <svg class="kinetic-fallback" viewBox="0 0 500 500" aria-hidden="true"><g transform="translate(250 250) rotate(-28)" fill="none" stroke="#b7ada0" stroke-width=".8">{loops.map(i => <ellipse rx={70 + i * 3} ry={160 - i * 2} transform={`rotate(${i * 5.625})`} />)}</g></svg>
    <canvas aria-hidden="true"></canvas>
    <span class="kinetic-cross cross-one" aria-hidden="true">+</span><span class="kinetic-cross cross-two" aria-hidden="true">+</span>
  </div>
  <figcaption><span class="motion-hint">MOVE TO EXPLORE ↗</span><button type="button" class="motion-toggle" aria-pressed="false" hidden>Pause motion</button></figcaption>
</figure>
<script>
  const figure = document.querySelector<HTMLElement>('.kinetic');
  const canvas = figure?.querySelector('canvas');
  const ctx = canvas?.getContext('2d');
  const button = figure?.querySelector<HTMLButtonElement>('button');
  if (figure && canvas && ctx && button) {
    const media = matchMedia('(prefers-reduced-motion: reduce)');
    let reduced = media.matches, paused = false, visible = true, frame = 0, last = 0, time = 0;
    let width = 0, height = 0, px = 0, py = 0, tx = 0, ty = 0, scroll = 0;
    const stage = canvas.parentElement!;
    const draw = () => {
      ctx.clearRect(0, 0, width, height);
      const scale = Math.min(width, height) / 395;
      const ax = .72 + py * .65 + scroll * .32;
      const ay = -.38 + px * .85;
      const az = -.42 + time * .075 + scroll * .23;
      const sinX = Math.sin(ax), cosX = Math.cos(ax), sinY = Math.sin(ay), cosY = Math.cos(ay), sinZ = Math.sin(az), cosZ = Math.cos(az);
      for (let ring = 0; ring < 64; ring++) {
        const u = ring / 64 * Math.PI * 2;
        ctx.beginPath();
        for (let j = 0; j <= 88; j++) {
          const v = j / 88 * Math.PI * 2;
          const r = 116 + 47 * Math.cos(v);
          let x = r * Math.cos(u), y = r * Math.sin(u), z = 47 * Math.sin(v) + 17 * Math.sin(u * 3 + time * .22);
          const y1 = y * cosX - z * sinX, z1 = y * sinX + z * cosX;
          const x1 = x * cosY + z1 * sinY, z2 = -x * sinY + z1 * cosY;
          const x2 = x1 * cosZ - y1 * sinZ, y2 = x1 * sinZ + y1 * cosZ;
          const perspective = 620 / (620 + z2);
          x = width / 2 + x2 * scale * perspective; y = height / 2 + y2 * scale * perspective;
          if (j === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        const bright = .43 + .42 * (Math.sin(u + ay) + 1) / 2;
        ctx.strokeStyle = ring > 43 && ring < 51 ? `rgba(218,151,111,${bright + .15})` : `rgba(217,210,198,${bright})`;
        ctx.lineWidth = ring > 43 && ring < 51 ? 1 : .75;
        ctx.stroke();
      }
    };
    const tick = (now: number) => {
      frame = 0;
      if (!visible || document.hidden || paused || reduced) return;
      if (now - last >= 1000 / 30) {
        time += Math.min((now - last) / 1000, .05); last = now;
        px += (tx - px) * .09; py += (ty - py) * .09;
        scroll = Math.max(0, Math.min(1, -figure.getBoundingClientRect().top / innerHeight));
        draw();
      }
      frame = requestAnimationFrame(tick);
    };
    const sync = () => {
      cancelAnimationFrame(frame); frame = 0; last = performance.now();
      button.textContent = paused ? 'Resume motion' : 'Pause motion';
      button.setAttribute('aria-pressed', String(paused));
      button.hidden = reduced;
      if (reduced) { px = py = scroll = time = 0; draw(); }
      else if (visible && !document.hidden && !paused) frame = requestAnimationFrame(tick);
    };
    const resize = () => {
      width = stage.clientWidth; height = stage.clientHeight;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * dpr); canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0); draw();
    };
    new ResizeObserver(resize).observe(stage);
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); }).observe(figure);
    document.addEventListener('visibilitychange', sync);
    media.addEventListener('change', () => { reduced = media.matches; sync(); });
    figure.addEventListener('pointermove', event => {
      if (reduced || paused) return;
      const box = figure.getBoundingClientRect();
      tx = Math.max(-1, Math.min(1, (event.clientX - box.left) / box.width * 2 - 1));
      ty = Math.max(-1, Math.min(1, (event.clientY - box.top) / box.height * 2 - 1));
    }, { passive: true });
    figure.addEventListener('pointerleave', () => { tx = ty = 0; });
    figure.addEventListener('pointerup', event => { if (event.pointerType === 'touch') { tx = ty = 0; } });
    button.addEventListener('click', () => { paused = !paused; sync(); });
    figure.classList.add('is-ready'); resize(); sync();
  }
</script>
<style>
.kinetic{margin:0;position:relative;min-width:0;align-self:stretch;display:flex;flex-direction:column;justify-content:space-between;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.kinetic-caption,.kinetic figcaption{display:flex;align-items:center;justify-content:space-between;gap:12px;font:9px var(--mono);letter-spacing:1px;color:var(--muted);padding:19px 0}
.kinetic-stage{position:relative;min-height:380px;flex:1;touch-action:pan-y}
.kinetic canvas,.kinetic-fallback{position:absolute;inset:0;width:100%;height:100%}.kinetic canvas{opacity:0}.kinetic.is-ready canvas{opacity:1}.kinetic.is-ready .kinetic-fallback{display:none}
.kinetic-cross{position:absolute;color:#69675f;font:16px var(--mono)}.cross-one{top:10px;left:0}.cross-two{bottom:10px;right:0}
.motion-toggle{padding:7px 0 7px 14px;min-height:34px;border:0;background:none;color:var(--ink);font:10px var(--mono);cursor:pointer;text-decoration:underline;text-underline-offset:4px}.motion-toggle:hover{color:var(--green)}
@media(max-width:720px){.kinetic-stage{min-height:330px}.kinetic-caption,.kinetic figcaption{padding-block:15px}.motion-hint{font-size:0}.motion-hint:after{content:'TOUCH / SCROLL TO EXPLORE';font-size:9px}}
@media(prefers-reduced-motion:reduce){.motion-hint{font-size:0}.motion-hint:after{content:'STILL STUDY / REDUCED MOTION';font-size:9px}}
</style>
