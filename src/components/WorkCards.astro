---
import MagicCard from './21st/MagicCard.astro';
---

<div class="work-grid">
  <MagicCard href="/projects/#personal-site">
    <div class="work-visual" aria-hidden="true">
      <div class="mini-browser">
        <div class="browser-dots">
          <i></i>
          <i></i>
          <i></i>
        </div>
        <div class="mini-title">
          A little corner.
          <br />
          <em>A bigger picture.</em>
        </div>
        <div class="mini-line"></div>
        <div class="mini-line"></div>
      </div>
    </div>
    <div class="work-meta">
      <span class="tag">01 / Web · Design · Development</span>
      <div class="work-title">
        <h3>A home on the internet</h3>
        <span class="arrow" aria-hidden="true"></span>
      </div>
      <p>
        A personal site built in public. Small by design, with room for writing,
        experiments, and everything that comes next.
      </p>
    </div>
  </MagicCard>
  <MagicCard href="/projects/#edge-counter">
    <div class="work-visual dark" aria-hidden="true">
      <div class="counter-title">
        A WINDOW INTO THE LAST<strong>24 hours.</strong>
      </div>
      <div class="counter-note">
        WORKER → KV
        <br />
        <br />
        ROLLING WINDOW
      </div>
      <div class="signal">
        {[
          12, 17, 12, 29, 23, 37, 46, 35, 54, 47, 39, 56, 78, 57, 42, 67, 51,
          32, 45, 34, 20, 28, 16, 11,
        ].map((h) => (
          <i style={`height:${h}px`}></i>
        ))}
      </div>
    </div>
    <div class="work-meta">
      <span class="tag">02 / Edge computing · Past experiment</span>
      <div class="work-title">
        <h3>A lightweight view counter</h3>
        <span class="arrow" aria-hidden="true"></span>
      </div>
      <p>
        A retired experiment in serverless systems: hourly buckets, a rolling
        window, and an API alongside static assets.
      </p>
    </div>
  </MagicCard>
</div>
