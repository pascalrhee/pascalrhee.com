---
---
<div class="attendance" data-attendance>
  <div class="attendance-value" data-attendance-value aria-live="polite">
    <span class="attendance-placeholder" aria-hidden="true">·</span>
  </div>
  <div class="attendance-caption">
    <span class="attendance-label">Attendance</span>
    <span class="attendance-window" data-attendance-window>past 24 hours</span>
  </div>
</div>

<script is:inline>
  (() => {
    const line = document.querySelector('[data-attendance]');
    const value = line?.querySelector('[data-attendance-value]');
    const windowEl = line?.querySelector('[data-attendance-window]');
    if (!line || !value || !windowEl) return;

    // Fire-and-forget: increment the current hour bucket.
    fetch('/api/track', { method: 'POST' }).catch(() => {});

    // Read the rolling 24h sum and render, or remove the whole line on failure.
    fetch('/api/views')
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then(({ count, visible }) => {
        if (!visible) {
          line.remove();
          return;
        }
        value.textContent = String(count);
        windowEl.textContent = `past 24 hours · ${count === 1 ? '1 load' : count + ' loads'}`;
        line.classList.add('is-ready');
      })
      .catch(() => {
        line.remove();
      });
  })();
</script>

<style>
  .attendance {
    display: flex;
    align-items: baseline;
    gap: 1.75rem;
    padding: 1.5rem 0 1.75rem;
    margin: 2rem 0 1rem;
    border-top: 2px solid var(--blue);
    border-bottom: 2px solid var(--blue);
    position: relative;
  }

  /* Maize hairline that rides just under the top blue rule — team stripe */
  .attendance::before {
    content: "";
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--maize);
  }

  .attendance-value {
    font-family: 'EB Garamond', Georgia, serif;
    font-weight: 500;
    font-style: italic;
    font-size: clamp(3rem, 9vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--blue);
    opacity: 0.35;
    transform: translateY(6px);
    transition: opacity 0.7s cubic-bezier(0.2, 0.6, 0.2, 1),
                transform 0.7s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .attendance.is-ready .attendance-value {
    opacity: 1;
    transform: translateY(0);
  }

  .attendance-placeholder {
    display: inline-block;
    opacity: 0.4;
  }

  .attendance-caption {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .attendance-label {
    font-family: 'EB Garamond SC', 'EB Garamond', Georgia, serif;
    font-weight: 500;
    letter-spacing: 0.2em;
    font-size: 0.78rem;
    color: var(--tan);
  }

  .attendance-window {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--blue);
  }

  @media (prefers-reduced-motion: reduce) {
    .attendance-value { transition: none; opacity: 1; transform: none; }
  }
</style>
