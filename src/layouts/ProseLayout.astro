---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; dek?: string; date: string; readingTime?: string; section?: string }
const { title, dek, date, readingTime, section = 'writing' } = Astro.props;
const formattedDate = new Date(`${date}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title={`${title} · Pascal Rhee`} description={dek ?? title} section={section}>
  <article class="post"><header><a class="text-link" href="/writing/">← All writing</a><p class="section-label" style="margin-top:35px"><time datetime={date}>{formattedDate}</time>{readingTime && ` · ${readingTime}`}</p><h1>{title}</h1>{dek && <p class="post-dek">{dek}</p>}<p class="note">By Pascal Rhee</p></header><div class="post-body"><slot /></div><footer class="post-foot"><a href="/writing/">← Back to all writing</a></footer></article>
</BaseLayout>
