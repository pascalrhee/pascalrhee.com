---
export interface Props {
  title?: string;
  description?: string;
  section?: 'writing' | 'projects' | 'about' | 'home';
}
const {
  title = 'Pascal Rhee',
  description = 'Pascal Rhee — a personal site, currently being built in public.',
  section = 'home',
} = Astro.props;

const sections = [
  { key: 'writing', label: 'Writing', href: '/writing/' },
  { key: 'projects', label: 'Projects', href: '/projects/' },
  { key: 'about', label: 'About', href: '/about/' },
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%2300274C%22/><text x=%2250%22 y=%2278%22 text-anchor=%22middle%22 font-family=%22Georgia,serif%22 font-weight=%22700%22 font-style=%22italic%22 font-size=%2280%22 fill=%22%23FFCB05%22>M</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&family=EB+Garamond+SC:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --blue: #00274c;
        --blue-deep: #0d1929;
        --maize: #ffcb05;
        --paper: #f5f1e8;
        --paper-soft: #e8e2d2;
        --tan: #8b7c5a;
        --ink: #1a1a1a;
        --rule: #d7cfbc;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      html, body { height: 100%; }

      body {
        background: var(--paper);
        color: var(--blue);
        font-family: 'EB Garamond', Georgia, serif;
        font-weight: 400;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        background-image:
          radial-gradient(circle at 15% 12%, rgba(0, 39, 76, 0.05), transparent 45%),
          radial-gradient(circle at 88% 88%, rgba(255, 203, 5, 0.08), transparent 42%);
        background-attachment: fixed;
      }

      main {
        min-height: 100vh;
        display: grid;
        grid-template-rows: auto auto 1fr auto;
        padding: 0 clamp(1.5rem, 5vw, 4rem) 2rem;
        max-width: 820px;
        margin: 0 auto;
      }

      /* ─── Signature top stripe: blue with a maize shadow-line beneath ─── */
      main::before {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 6px;
        background: var(--blue);
        box-shadow: 0 8px 0 var(--maize);
        z-index: 10;
      }

      /* ─── Site header: Block-M glyph · wordmark · Est. year ─── */
      .header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 3.25rem 0 1.25rem;
        border-bottom: 1px solid var(--tan);
        margin-bottom: 1rem;
      }

      .header-mark {
        display: flex;
        align-items: center;
        gap: 0.85rem;
      }

      .header-mark a {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        text-decoration: none;
        color: inherit;
      }

      .block-m {
        width: 34px;
        height: 34px;
        background: var(--blue);
        color: var(--maize);
        display: grid;
        place-items: center;
        font-family: 'EB Garamond', Georgia, serif;
        font-weight: 700;
        font-style: italic;
        font-size: 1.4rem;
        line-height: 1;
      }

      .wordmark {
        font-family: 'EB Garamond SC', 'EB Garamond', Georgia, serif;
        font-weight: 500;
        letter-spacing: 0.18em;
        font-size: 0.82rem;
        color: var(--blue);
      }

      .header-est {
        font-family: 'EB Garamond SC', 'EB Garamond', Georgia, serif;
        font-weight: 400;
        letter-spacing: 0.22em;
        font-size: 0.68rem;
        color: var(--tan);
        text-align: right;
        line-height: 1.35;
      }

      .header-est .year {
        color: var(--blue);
        font-weight: 500;
      }

      /* ─── Section nav: table-of-contents strip under the masthead ─── */
      .site-nav {
        display: flex;
        gap: 1.75rem;
        padding: 0.9rem 0 0.9rem;
        border-bottom: 1px solid var(--tan);
        margin-bottom: 1rem;
      }

      .site-nav a {
        font-family: 'EB Garamond SC', 'EB Garamond', Georgia, serif;
        font-weight: 500;
        letter-spacing: 0.18em;
        font-size: 0.74rem;
        color: var(--blue);
        text-decoration: none;
        border-bottom: none;
        padding: 0.15rem 0;
        transition: background 0.2s;
      }

      .site-nav a:hover {
        background: linear-gradient(
          to top,
          var(--maize) 0%,
          var(--maize) 30%,
          transparent 30%
        );
      }

      .site-nav a[aria-current="page"] {
        background: linear-gradient(
          to top,
          var(--maize) 0%,
          var(--maize) 30%,
          transparent 30%
        );
      }

      .site-nav a[aria-current="page"]::before {
        content: "§ ";
        color: var(--blue);
        opacity: 0.55;
        margin-right: 0.1rem;
      }

      /* ─── Content area ─── */
      .content {
        display: flex;
        flex-direction: column;
        padding: 2.5rem 0 3rem;
      }

      /* ─── Kicker: small-caps section label with maize § ─── */
      .kicker {
        font-family: 'EB Garamond SC', 'EB Garamond', Georgia, serif;
        font-weight: 500;
        letter-spacing: 0.22em;
        font-size: 0.72rem;
        color: var(--tan);
        margin-bottom: 1rem;
      }
      .kicker::before {
        content: "§ ";
        color: var(--maize);
        -webkit-text-stroke: 0.5px var(--blue);
        margin-right: 0.15rem;
      }

      /* ─── Display type ─── */
      h1 {
        font-family: 'EB Garamond', Georgia, serif;
        font-weight: 500;
        font-size: clamp(2.5rem, 6vw, 4rem);
        line-height: 0.98;
        letter-spacing: -0.015em;
        color: var(--blue);
        margin-bottom: 1.5rem;
      }

      h1 em, h1 .italic {
        font-style: italic;
        font-weight: 500;
        background: linear-gradient(
          to top,
          var(--maize) 0%,
          var(--maize) 32%,
          transparent 32%,
          transparent 100%
        );
        padding: 0 0.1em;
      }

      /* ─── Lede ─── */
      .lede {
        font-family: 'EB Garamond', Georgia, serif;
        font-weight: 400;
        font-size: clamp(1.05rem, 1.7vw, 1.2rem);
        line-height: 1.6;
        color: var(--ink);
        max-width: 46ch;
        margin-bottom: 1rem;
      }

      .lede em {
        font-style: italic;
        color: var(--blue);
        font-weight: 500;
      }

      /* ─── Links (in prose) ─── */
      a {
        color: var(--blue);
        text-decoration: none;
        border-bottom: 1px solid var(--tan);
        padding-bottom: 1px;
        transition: color 0.2s, border-color 0.2s, background 0.2s;
      }
      a:hover {
        border-bottom-color: var(--blue);
        background: linear-gradient(
          to top,
          var(--maize) 0%,
          var(--maize) 25%,
          transparent 25%
        );
      }

      /* ─── Footer ─── */
      .footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 0 0.5rem;
        border-top: 2px solid var(--blue);
        margin-top: 2rem;
        position: relative;
        font-family: 'EB Garamond SC', 'EB Garamond', Georgia, serif;
        font-weight: 400;
        letter-spacing: 0.18em;
        font-size: 0.7rem;
        color: var(--tan);
      }
      .footer::before {
        content: "";
        position: absolute;
        top: 4px;
        left: 0;
        right: 0;
        height: 1px;
        background: var(--maize);
      }
      .footer .colophon {
        color: var(--blue);
      }
      .footer a {
        color: inherit;
        border-bottom-color: currentColor;
      }
      .footer a:hover {
        color: var(--blue);
      }

      /* ─── Staggered rise-in on content children ─── */
      .content > * {
        opacity: 0;
        transform: translateY(8px);
        animation: rise 0.9s cubic-bezier(0.2, 0.6, 0.2, 1) forwards;
      }
      .content > *:nth-child(1) { animation-delay: 0.1s; }
      .content > *:nth-child(2) { animation-delay: 0.25s; }
      .content > *:nth-child(3) { animation-delay: 0.4s; }
      .content > *:nth-child(4) { animation-delay: 0.55s; }
      .content > *:nth-child(5) { animation-delay: 0.7s; }
      .content > *:nth-child(n+6) { animation-delay: 0.85s; }

      @keyframes rise {
        to { opacity: 1; transform: translateY(0); }
      }

      @media (prefers-reduced-motion: reduce) {
        .content > * { animation: none; opacity: 1; transform: none; }
      }
    </style>
  </head>
  <body>
    <main>
      <header class="header">
        <div class="header-mark">
          <a href="/" aria-label="pascalrhee.com — home">
            <div class="block-m" aria-hidden="true">M</div>
            <div class="wordmark">Pascal · Rhee</div>
          </a>
        </div>
        <div class="header-est">
          Est.<br /><span class="year">MMIII</span>
        </div>
      </header>

      <nav class="site-nav" aria-label="Sections">
        {sections.map((s) => (
          <a href={s.href} aria-current={section === s.key ? 'page' : undefined}>
            {s.label}
          </a>
        ))}
      </nav>

      <slot />

      <footer class="footer">
        <span class="colophon">© Pascal Rhee</span>
        <span>Winter '26 · more soon</span>
      </footer>
    </main>
  </body>
</html>
